# Claude — 코디세이 Anthropic 호환 API
# 코디세이에서 받은 키(토큰)를 넣는다
ANTHROPIC_API_KEY=코디세이에서_받은_키
# 주소 끝에 /v1을 붙이지 않는다 (SDK가 /v1/messages를 직접 붙임)
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
# claude-sonnet-4 (Sonnet 4.6) / claude-haiku-4 (Haiku 4.5, 더 저렴)
ANTHROPIC_MODEL=claude-sonnet-4
# 기본 모델이 혼잡할 때 대신 쓸 모델 (쉼표로 구분)
ANTHROPIC_FALLBACK_MODELS=claude-haiku-4

# Firebase 서비스 계정 키 (둘 중 하나만 설정)
# 1) 로컬: 키 파일 경로
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# 2) 배포(Render): 키 JSON 전체를 한 줄 문자열로
# FIREBASE_CREDENTIALS={"type":"service_account",...}
# Firestore 데이터베이스 ID (기본 DB면 생략, 이 프로젝트는 default)
FIRESTORE_DATABASE_ID=default

# 허용할 프론트엔드 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 이 값 이상이면 스트레스 날 음악을 자동 저장
STRESS_THRESHOLD=7
